PORT=5000
NODE_ENV=development
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Reserved for a future MongoDB migration. The current app uses SQLite.
MONGO_URI=mongodb://127.0.0.1:27017/campus_knowledge_hub

# Configure the real administrator used by the admin console in every environment.
ADMIN_EMAIL=admin@your-campus.edu
ADMIN_NAME=LearnConnect Admin
ADMIN_PASSWORD=replace-this-with-a-unique-password-12-plus-chars
